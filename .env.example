# Resend (https://resend.com) — used to send quote-request emails.
# Without this set, submissions are logged server-side instead of emailed.
RESEND_API_KEY=

# Sender address for outgoing emails. Must be a verified sender/domain in Resend.
# Defaults to the Resend sandbox sender if unset (only deliverable to your own Resend account email during testing).
QUOTE_FROM_EMAIL="RankVibez <onboarding@resend.dev>"

# Inbox that receives new quote requests. Defaults to the address in src/data/contact.ts if unset.
BUSINESS_EMAIL=admin@rankvibez.com
